# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and CSRF verification)
# Production: e.g. https://hirenex.vercel.app
FRONTEND_URL=https://hirenex.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas production cluster or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hirenex?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/hirenex

# JWT Secret & Expiry Configuration
JWT_SECRET=your_super_secret_64_character_random_hex_string
JWT_EXPIRES_IN=7d

# Google Gemini API Key & Model
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
